{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@engine/*": [
        "src/engine/*"
      ],
      "@data/*": [
        "src/data/*"
      ],
      "@ui/*": [
        "src/tabletop/ui/*"
      ],
      "@store/*": [
        "src/tabletop/store/*"
      ],
      "@tt/*": [
        "src/tabletop/*"
      ]
    },
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "node"
    ]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts"
  ]
}
