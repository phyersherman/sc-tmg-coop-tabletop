{
  "name": "sc-tmg-coop-tabletop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "snapshot": "node --experimental-strip-types scripts/snapshot-units.ts",
    "desktop": "node scripts/build-desktop.mjs all",
    "desktop:mac": "node scripts/build-desktop.mjs mac",
    "desktop:win": "node scripts/build-desktop.mjs win"
  },
  "dependencies": {
    "js-aruco2": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^44.4.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.1"
  },
  "main": "electron/main.cjs",
  "productName": "Co-op Command Tabletop"
}
